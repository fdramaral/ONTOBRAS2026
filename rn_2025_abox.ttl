    rdfs:label "Potência média nas horas com corte"@pt ;
    cover:hasUnit "MWmed" ;
    cover:hasValue "1847.0"^^xsd:float ;
    side:hasSourceCitation "ONS (2026a)" ;
    side:hasSymbol "P_med" ;
    side:isDerived false .

side:RioGrandeDoNorte_2025 a side:DecisionContext,
        owl:NamedIndividual ;
    rdfs:label "Rio Grande do Norte, Abr/2024–Mar/2026"@pt .

side:int_high_revenue a side:HighRevenueIntention,
        owl:NamedIndividual .

side:rn_2025_tmset a cover:TruthmakerSet,
        owl:NamedIndividual ;
    cover:hasMember side:tm_capacidade_instalada,
        side:tm_capex_awe_850,
        side:tm_capex_bess_320,
        side:tm_ciclos_ano,
        side:tm_coff_eolico,
        side:tm_custo_logistico,
        side:tm_distancia_pecem,
        side:tm_eta_impl,
        side:tm_eta_rt_090,
        side:tm_fc_595,
        side:tm_fcr_1468,
        side:tm_horas_ativas,
        side:tm_infra_portuaria,
        side:tm_kappa_525,
        side:tm_lcoh_195,
        side:tm_lcos_145,
        side:tm_mwmed_janelas,
        side:tm_paridade_h2_250,
        side:tm_pld_arbitragem_92,
        side:tm_potencia_1000,
        side:tm_wacc_012 ;
    side:hasContext side:RioGrandeDoNorte_2025 .

side:rn_industrial_investor a side:IndustrialInvestor,
        owl:NamedIndividual ;
    rdfs:label "Investidor industrial (RN)"@pt ;
