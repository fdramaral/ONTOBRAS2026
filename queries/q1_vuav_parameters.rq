# ---------------------------------------------------------------------------
# Q1 — Parâmetros da função VUAV por estratégia.
# Recupera L(GEi|ctx) e I(GEi) para cada Gain Event e L(LEj|s,ctx) e S(LEj)
# para cada Loss Event, tornando o cálculo auditável termo a termo.
# ---------------------------------------------------------------------------
SELECT ?strategy ?termType ?event ?likelihood ?magnitude ?growth WHERE {
  ?d cover:mediates ?strategy .
  ?strategy a/rdfs:subClassOf* side:EnergyStrategy .
  {
    ?strategy cover:hasCapability/cover:manifestsAs ?event .
    ?event a cover:GainEvent ;
           cover:hasLikelihood ?likelihood ;
           cover:hasImpact ?magnitude .
    BIND("gain" AS ?termType)
  } UNION {
    ?strategy cover:hasVulnerability ?v .
    ?v cover:produces ?event ; side:isActive true .
    ?event a cover:LossEvent ;
           cover:hasLikelihood ?likelihood ;
           cover:hasSeverity ?magnitude .
    BIND("loss" AS ?termType)
  }
  OPTIONAL { ?event side:hasLikelihoodGrowthRate ?growth }
}
ORDER BY ?strategy ?termType
