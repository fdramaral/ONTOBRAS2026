# ---------------------------------------------------------------------------
# Q3 — Cadeia causal Vulnerability -> Loss Event -> Intention.
# Segunda etapa do ontological unpacking: a explicação estruturada não é uma
# correlação estatística, mas uma sequência ontológica de causação.
# Retorna apenas vulnerabilidades manifestas (side:isActive true).
# ---------------------------------------------------------------------------
SELECT ?strategy ?vulnerability ?lossEvent ?intention ?truthmaker ?symbol ?value ?unit WHERE {
  ?strategy cover:hasVulnerability ?vulnerability .
  ?vulnerability side:isActive true ;
                 cover:produces ?lossEvent .
  ?lossEvent cover:impactsNegatively ?intention ;
             side:groundedInTruthmaker ?truthmaker .
  ?truthmaker side:hasSymbol ?symbol ;
              cover:hasValue ?value ;
              cover:hasUnit ?unit .
}
ORDER BY ?strategy ?vulnerability ?symbol
