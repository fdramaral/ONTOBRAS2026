@prefix cover: <http://purl.org/side/cover#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix side: <http://purl.org/side/energy#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ufo: <http://purl.org/side/ufo#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cover:RiskExperience a owl:Class ;
    rdfs:subClassOf ufo:Event .

cover:ThreatCapability a owl:Class ;
    rdfs:subClassOf ufo:Disposition .

cover:ThreatEvent a owl:Class ;
    rdfs:subClassOf ufo:Event .

cover:ValueExperience a owl:Class ;
    rdfs:subClassOf ufo:Event .

cover:hasImpact a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    skos:definition "I(·): impacto positivo do Gain Event sobre as Intentions do agente, em USD/ano."@pt .

cover:hasLikelihood a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    skos:definition "L(·): probabilidade ou grau de crença na ocorrência do evento, dado o contexto e a estratégia."@pt .

cover:hasMember a owl:ObjectProperty ;
    rdfs:domain cover:TruthmakerSet ;
    rdfs:range cover:Truthmaker .

cover:hasSeverity a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    skos:definition "S(·): severidade negativa do Loss Event sobre as Intentions do agente, em USD/ano."@pt .

cover:hasUnit a owl:DatatypeProperty ;
    rdfs:range xsd:string .

cover:hasValue a owl:DatatypeProperty ;
    rdfs:range xsd:float .

cover:inheresIn a owl:ObjectProperty ;
    rdfs:domain ufo:Moment ;
    rdfs:range ufo:Endurant .

cover:isActivatedBy a owl:ObjectProperty ;
    rdfs:domain cover:Vulnerability ;
    rdfs:range cover:ThreateningSituation .

cover:triggeredBy a owl:ObjectProperty ;
    rdfs:range cover:TriggerEvent .

<http://purl.org/side/energy> a owl:Ontology ;
    dct:creator "Fernanda Baião",
        "Francisco D. R. do Amaral",
        "Mateus Peixoto",
        "Paula Maçaira" ;
    dct:description "Especialização da Common Ontology of Value and Risk (COVeR) ao domínio de planejamento energético, com truthmakers mensuráveis, refinamento ontológico da estratégia de não investimento (NI) e a função VUAV como operacionalização da Net Use Value Ascription."@pt ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rightsHolder "Amaral, Peixoto, Baião e Maçaira (2026)" ;
    dct:title "SIDE: extensão da COVeR para decisão de investimento em aproveitamento de constrained-off renovável"@pt ;
    rdfs:seeAlso <http://purl.org/side/cover> ;
    owl:versionInfo "1.0.0" .

side:CompetencyQuestion a owl:Class .

side:ESGInvestor a owl:Class ;
    rdfs:subClassOf side:EnergyInvestor .

side:LowCarbonEmissionIntention a owl:Class ;
    rdfs:subClassOf cover:Intention .

side:derivationFormula a owl:DatatypeProperty ;
    rdfs:range xsd:string .

side:groundedInTruthmaker a owl:ObjectProperty ;
    rdfs:comment "Rastreabilidade de um Gain/Loss Event às entidades que o tornam verdadeiro."@pt ;
    rdfs:domain cover:ImpactEvent ;
    rdfs:range cover:Truthmaker .

side:hasBearerStatus a owl:ObjectProperty ;
    rdfs:domain side:EnergyStrategy ;
    rdfs:range cover:ProspectBearer .

side:hasContext a owl:ObjectProperty ;
    rdfs:range side:DecisionContext .

side:hasLikelihoodGrowthRate a owl:DatatypeProperty ;
    rdfs:range xsd:float ;
    skos:definition "Taxa anual de crescimento de L(LE|s,ctx), usada para representar vulnerabilidades de magnitude crescente (e.g. OpportunityCostVulnerability de NI)."@pt .

side:hasSourceCitation a owl:DatatypeProperty ;
    rdfs:range xsd:string .

side:hasSymbol a owl:DatatypeProperty ;
    rdfs:range xsd:string .

side:hasThreshold a owl:DatatypeProperty ;
    rdfs:range xsd:float .

side:hasThresholdDirection a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    skos:definition "'geq' ou 'leq': direção em que a alteração do truthmaker inverte a preferência."@pt .

side:isActive a owl:DatatypeProperty ;
    rdfs:domain cover:Vulnerability ;
    rdfs:range xsd:boolean ;
    skos:definition "Verdadeiro quando a Vulnerability está manifesta no contexto avaliado. Uma vulnerability inativa permanece inerente à estratégia, mas não produz Loss Events — é essa distinção que torna a reversão de preferência representável."@pt .

side:isDerived a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    skos:definition "Verdadeiro quando o valor do truthmaker é derivado de outros truthmakers e não medido diretamente."@pt .

side:occursIn a owl:ObjectProperty ;
    rdfs:domain ufo:Event ;
    rdfs:range side:CurtailmentWindow .

side:revertsPreferenceOf a owl:ObjectProperty ;
    rdfs:domain side:CounterfactualClaim ;
    rdfs:range side:EnergyStrategy .

side:rn_2025_feasibility_study a side:FeasibilityStudy,
        owl:NamedIndividual ;
    rdfs:label "Estudo de viabilidade RN 2025"@pt ;
    side:hasContext side:RioGrandeDoNorte_2025 ;
    side:qualifies side:tm_capacidade_instalada,
        side:tm_capex_awe_850,
        side:tm_capex_bess_320,
        side:tm_ciclos_ano,
        side:tm_coff_eolico,
        side:tm_custo_logistico,
        side:tm_distancia_pecem,
        side:tm_eta_impl,
        side:tm_eta_rt_090,
        side:tm_fc_595,
        side:tm_fcr_1468,
        side:tm_horas_ativas,
        side:tm_infra_portuaria,
        side:tm_kappa_525,
        side:tm_lcoh_195,
        side:tm_lcos_145,
        side:tm_mwmed_janelas,
        side:tm_paridade_h2_250,
        side:tm_pld_arbitragem_92,
        side:tm_potencia_1000,
        side:tm_wacc_012 .

side:rn_bess_decision a side:EnergyInvestmentDecision,
        owl:NamedIndividual ;
    cover:isGroundedIn side:rn_2025_tmset ;
    cover:mediates side:rn_bess_strategy,
        side:rn_industrial_investor ;
    cover:triggeredBy side:rn_bess_decision_trigger ;
    side:hasVUAV side:rn_bess_decision_netusevalue .

side:rn_h2v_decision a side:EnergyInvestmentDecision,
        owl:NamedIndividual ;
    cover:isGroundedIn side:rn_2025_tmset ;
    cover:mediates side:rn_h2v_strategy,
        side:rn_industrial_investor ;
    cover:triggeredBy side:rn_h2v_decision_trigger ;
    side:hasVUAV side:rn_h2v_decision_netusevalue .

side:rn_ni_decision a side:EnergyInvestmentDecision,
        owl:NamedIndividual ;
    cover:isGroundedIn side:rn_2025_tmset ;
    cover:mediates side:rn_industrial_investor,
        side:rn_ni_strategy ;
    cover:triggeredBy side:rn_ni_decision_trigger ;
    side:hasVUAV side:rn_ni_decision_netusevalue .

cover:RiskAssessment a owl:Class ;
    rdfs:subClassOf cover:ValueAscription ;
    skos:definition "Caso particular de atribuição de valor: avaliação de risco como valor de uso negativo."@pt .

cover:RiskEnabler a owl:Class ;
    rdfs:subClassOf ufo:Object .

cover:RiskSubject a owl:Class ;
    rdfs:subClassOf ufo:Agent .

cover:UseValue a owl:Class ;
    rdfs:subClassOf ufo:Quality .

cover:ValueEnabler a owl:Class ;
    rdfs:subClassOf ufo:Object .

cover:ValueObject a owl:Class ;
    rdfs:subClassOf ufo:Object .

cover:ValueSubject a owl:Class ;
    rdfs:subClassOf ufo:Agent .

cover:hasIntention a owl:ObjectProperty ;
    rdfs:domain ufo:Agent ;
    rdfs:range cover:Intention .

cover:isGroundedIn a owl:ObjectProperty ;
    rdfs:comment "Conecta uma decisão ao conjunto de truthmakers que a fundamentam."@pt .

side:BatteryInvestmentNeed a owl:Class ;
    rdfs:subClassOf cover:ThreateningSituation .

side:CurtailmentWithBatteryInvestment a owl:Class ;
    rdfs:subClassOf cover:TriggerEvent .

side:CurtailmentWithElectrolyzerInvestment a owl:Class ;
    rdfs:subClassOf cover:TriggerEvent .

side:CurtailmentWithNoInvestment a owl:Class ;
    rdfs:subClassOf cover:TriggerEvent .

side:ElectrolyzerInvestmentNeed a owl:Class ;
    rdfs:subClassOf cover:ThreateningSituation .

side:GenerationCapacityConstrainedByCurtailment a owl:Class ;
    rdfs:subClassOf cover:ThreateningSituation .

side:H2PriceInstability a owl:Class ;
    rdfs:subClassOf cover:ThreateningSituation ;
    skos:definition "Volatilidade do preço internacional do H₂ como ameaça distinta da IntermittentCurtailmentVulnerability."@pt .

side:IndustrialInvestor a owl:Class ;
    rdfs:subClassOf side:EnergyInvestor .

side:LogisticsDistanceVulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:produces ;
            owl:someValuesFrom side:LogisticsLoss ],
        cover:Vulnerability ;
    skos:definition "Distância ao porto de exportação e ausência de infraestrutura portuária de H₂, adicionando custo logístico ao LCOH."@pt .

side:TruthmakerClaim a owl:Class ;
    skos:definition "Afirmação verificável que identifica quais entidades do mundo fundamentam a preferência sobre uma estratégia."@pt .

side:altersTruthmaker a owl:ObjectProperty ;
    rdfs:domain side:CounterfactualClaim ;
    rdfs:range cover:Truthmaker .

side:cap_energy_arbitrage a cover:Capability,
        side:EnergyArbitrageCapability,
        owl:NamedIndividual ;
    rdfs:label "Absorção do excedente e reinjeção em períodos de escassez"@pt ;
    cover:inheresIn side:rn_bess_strategy ;
    cover:manifestsAs side:ge_arbitrage .

side:cap_financial_flexibility a cover:Capability,
        side:FinancialFlexibilityCapability,
        owl:NamedIndividual ;
    rdfs:label "Preservação de flexibilidade financeira"@pt ;
    cover:inheresIn side:rn_ni_strategy ;
    cover:manifestsAs side:ge_capex_preservation .

side:cap_h2_production a cover:Capability,
        side:H2ProductionCapability,
        owl:NamedIndividual ;
    rdfs:label "Conversão de energia excedente em H2 durante a CurtailmentWindow"@pt ;
    cover:inheresIn side:rn_h2v_strategy ;
    cover:manifestsAs side:ge_h2_production .

side:cap_regulatory_avoidance a cover:Capability,
        side:RegulatoryRiskAvoidanceCapability,
        owl:NamedIndividual ;
    rdfs:label "Evitação de risco regulatório"@pt ;
    cover:inheresIn side:rn_ni_strategy ;
    cover:manifestsAs side:ge_regulatory_avoidance .

side:cap_techlockin_avoidance a cover:Capability,
        side:TechLockInAvoidanceCapability,
        owl:NamedIndividual ;
    rdfs:label "Evitação de lock-in tecnológico"@pt ;
    cover:inheresIn side:rn_ni_strategy ;
    cover:manifestsAs side:ge_techlockin_avoidance .

side:ge_capex_preservation a cover:GainEvent,
        side:CapexPreservationGain,
        owl:NamedIndividual ;
    rdfs:label "Preservação de CAPEX — custo de oportunidade do capital não imobilizado"@pt ;
    cover:hasImpact "102000000.0"^^xsd:float ;
    cover:hasLikelihood "1.0"^^xsd:float ;
    cover:impactsPositively side:int_fin_flex ;
    side:groundedInTruthmaker side:tm_capex_awe_850,
        side:tm_wacc_012 ;
    side:occursIn side:rn_curtailment_window .

side:ge_regulatory_avoidance a cover:GainEvent,
        side:RegulatoryRiskAvoidanceGain,
        owl:NamedIndividual ;
    rdfs:label "Evitação de exposição a marco regulatório incipiente"@pt ;
    cover:hasImpact "15000000.0"^^xsd:float ;
    cover:hasLikelihood "0.5"^^xsd:float ;
    cover:impactsPositively side:int_compliance ;
    side:occursIn side:rn_curtailment_window .

side:ge_techlockin_avoidance a cover:GainEvent,
        side:TechLockInAvoidanceGain,
        owl:NamedIndividual ;
    rdfs:label "Evitação de lock-in tecnológico"@pt ;
    cover:hasImpact "25000000.0"^^xsd:float ;
    cover:hasLikelihood "0.6"^^xsd:float ;
    cover:impactsPositively side:int_strat_flex ;
    side:groundedInTruthmaker side:tm_capex_awe_850,
        side:tm_capex_bess_320 ;
    side:occursIn side:rn_curtailment_window .

side:hasVUAV a owl:ObjectProperty ;
    rdfs:label "hasVUAV"@en ;
    rdfs:domain side:EnergyInvestmentDecision ;
    rdfs:range cover:NetUseValue ;
    skos:definition "Valor de Uso Líquido Ajustado por Vulnerabilidades — operacionalização quantitativa da Net Use Value Ascription da COVeR."@pt .

side:le_battery_degradation a cover:LossEvent,
        side:BatteryDegradationLoss,
        owl:NamedIndividual ;
    rdfs:label "Custo nivelado de armazenamento sob alta ciclagem (LCOS × energia)"@pt ;
    cover:hasLikelihood "1.0"^^xsd:float ;
    cover:hasSeverity "680192100.0"^^xsd:float ;
    cover:impactsNegatively side:int_low_cost ;
    side:groundedInTruthmaker side:tm_capex_bess_320,
        side:tm_ciclos_ano,
        side:tm_lcos_145 ;
    side:occursIn side:rn_curtailment_window .

side:le_electrolyzer_cost a cover:LossEvent,
        side:ElectrolyzerInvestmentCost,
        owl:NamedIndividual ;
    rdfs:label "Custo nivelado de produção de H2 (LCOH × produção)"@pt ;
    cover:hasLikelihood "1.0"^^xsd:float ;
    cover:hasSeverity "193596000.0"^^xsd:float ;
    cover:impactsNegatively side:int_low_cost ;
    side:groundedInTruthmaker side:tm_capex_awe_850,
        side:tm_kappa_525,
        side:tm_lcoh_195 ;
    side:occursIn side:rn_curtailment_window .

side:le_logistics a cover:LossEvent,
        side:LogisticsLoss,
        owl:NamedIndividual ;
    rdfs:label "Custo de escoamento do H2 ao porto de exportação"@pt ;
    cover:hasLikelihood "0.0"^^xsd:float ;
    cover:hasSeverity "0.0"^^xsd:float ;
    cover:impactsNegatively side:int_low_cost ;
    side:groundedInTruthmaker side:tm_custo_logistico,
        side:tm_distancia_pecem ;
    side:occursIn side:rn_curtailment_window .

side:le_revenue_opportunity a cover:LossEvent,
        side:RevenueOpportunityLoss,
        owl:NamedIndividual ;
    rdfs:label "Receita não capturada nas janelas de constrained-off"@pt ;
    cover:hasLikelihood "0.3"^^xsd:float ;
    cover:hasSeverity "248200000.0"^^xsd:float ;
    cover:impactsNegatively side:int_high_revenue ;
    side:groundedInTruthmaker side:tm_coff_eolico,
        side:tm_fc_595,
        side:tm_horas_ativas ;
    side:hasLikelihoodGrowthRate "0.05"^^xsd:float ;
    side:occursIn side:rn_curtailment_window .

side:qualifies a owl:ObjectProperty ;
    rdfs:domain side:FeasibilityStudy ;
    rdfs:range cover:Truthmaker .

side:rn_bess_decision_netusevalue a cover:NetUseValue,
        owl:NamedIndividual ;
    cover:hasUnit "USD/ano" ;
    cover:hasValue "-248621940.0"^^xsd:float .

side:rn_bess_decision_trigger a cover:TriggerEvent,
        side:CurtailmentWithBatteryInvestment,
        owl:NamedIndividual ;
    rdfs:label "Constrained-off com investimento em baterias"@pt ;
    side:occursIn side:rn_curtailment_window .

side:rn_bess_strategy_bearer a cover:DeprecatedBearer .

side:rn_h2v_decision_netusevalue a cover:NetUseValue,
        owl:NamedIndividual ;
    cover:hasUnit "USD/ano" ;
    cover:hasValue "54604000.0"^^xsd:float .

side:rn_h2v_decision_trigger a cover:TriggerEvent,
        side:CurtailmentWithElectrolyzerInvestment,
        owl:NamedIndividual ;
    rdfs:label "Constrained-off com investimento em eletrolisador"@pt ;
    side:occursIn side:rn_curtailment_window .

side:rn_h2v_strategy_bearer a cover:PreferredBearer .

side:rn_ni_decision_netusevalue a cover:NetUseValue,
        owl:NamedIndividual ;
    cover:hasUnit "USD/ano" ;
    cover:hasValue "50040000.0"^^xsd:float .

side:rn_ni_decision_trigger a cover:TriggerEvent,
        side:CurtailmentWithNoInvestment,
        owl:NamedIndividual ;
    rdfs:label "Constrained-off sem investimento"@pt ;
    side:occursIn side:rn_curtailment_window .

side:rn_ni_strategy_bearer a cover:DeprecatedBearer .

side:vul_capex_intensity a cover:Vulnerability,
        side:CapexIntensityVulnerability,
        owl:NamedIndividual ;
    rdfs:label "Imobilização de capital em ativo específico"@pt ;
    cover:inheresIn side:rn_h2v_strategy ;
    cover:isActivatedBy side:vul_capex_intensity_situation ;
    cover:produces side:le_electrolyzer_cost ;
    side:isActive true .

side:vul_capex_intensity_situation a side:H2PriceInstability,
        owl:NamedIndividual .

side:vul_high_cycling a cover:Vulnerability,
        side:HighCyclingDegradationVulnerability,
        owl:NamedIndividual ;
    rdfs:label "Degradação acelerada por alta ciclagem"@pt ;
    cover:inheresIn side:rn_bess_strategy ;
    cover:isActivatedBy side:vul_high_cycling_situation ;
    cover:produces side:le_battery_degradation ;
    side:isActive true .

side:vul_high_cycling_situation a side:BatteryInvestmentNeed,
        owl:NamedIndividual .

side:vul_intermittent_curtailment a cover:Vulnerability,
        side:IntermittentCurtailmentVulnerability,
        owl:NamedIndividual ;
    rdfs:label "Dependência do FC para a viabilidade econômica"@pt ;
    cover:inheresIn side:rn_h2v_strategy ;
    cover:isActivatedBy side:vul_intermittent_curtailment_situation ;
    side:isActive false ;
    side:threatens side:ge_h2_production .

side:vul_intermittent_curtailment_situation a side:ElectrolyzerInvestmentNeed,
        owl:NamedIndividual .

side:vul_logistics_distance a cover:Vulnerability,
        side:LogisticsDistanceVulnerability,
        owl:NamedIndividual ;
    rdfs:label "Distância e ausência de infraestrutura portuária de H2"@pt ;
    cover:inheresIn side:rn_h2v_strategy ;
    cover:produces side:le_logistics ;
    side:isActive false .

side:vul_low_pld_arbitrage a cover:Vulnerability,
        side:LowPLDArbitrageVulnerability,
        owl:NamedIndividual ;
    rdfs:label "PLD de despacho insuficiente para cobrir o LCOS"@pt ;
    cover:inheresIn side:rn_bess_strategy ;
    side:isActive true ;
    side:threatens side:ge_arbitrage .

side:vul_opportunity_cost a cover:Vulnerability,
        side:OpportunityCostVulnerability,
        owl:NamedIndividual ;
    rdfs:label "Custo de oportunidade das janelas não aproveitadas"@pt ;
    cover:inheresIn side:rn_curtailment_window,
        side:rn_ni_strategy ;
    cover:isActivatedBy side:vul_opportunity_cost_situation ;
    cover:produces side:le_revenue_opportunity ;
    side:isActive true .

side:vul_opportunity_cost_situation a side:GenerationCapacityConstrainedByCurtailment,
        owl:NamedIndividual .

ufo:InformationalArtifact a owl:Class ;
    rdfs:subClassOf ufo:Object .

ufo:Intention a owl:Class ;
    rdfs:subClassOf ufo:Moment .

ufo:Perdurant a owl:Class .

ufo:Quality a owl:Class ;
    rdfs:subClassOf ufo:Moment .

ufo:Situation a owl:Class .

cover:PreferredBearer a owl:Class ;
    rdfs:subClassOf cover:ProspectBearer .

cover:ValueAscription a owl:Class ;
    rdfs:subClassOf ufo:Relator ;
    skos:definition "Relator que conecta um agente avaliador (Value Subject) ao alvo do julgamento de valor de uso."@pt .

cover:mediates a owl:ObjectProperty ;
    rdfs:comment "Conecta um relator às entidades que ele existencialmente depende."@pt ;
    rdfs:domain ufo:Relator .

side:BatteryDegradationLoss a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsNegatively ;
            owl:someValuesFrom side:LowCostIntention ],
        cover:LossEvent ;
    skos:altLabel "BatteryInvestmentCost"@en .

side:CapexIntensityVulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:produces ;
            owl:someValuesFrom side:ElectrolyzerInvestmentCost ],
        cover:Vulnerability ;
    skos:definition "Imobilização de capital em ativo específico sem liquidação imediata; impacta negativamente a StrategicFlexibilityIntention."@pt .

side:CapexPreservationGain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsPositively ;
            owl:someValuesFrom side:FinancialFlexibilityIntention ],
        cover:GainEvent .

side:ComplianceCertaintyIntention a owl:Class ;
    rdfs:subClassOf cover:Intention .

side:CounterfactualClaim a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cover:Truthmaker ;
            owl:onProperty side:altersTruthmaker ],
        side:TruthmakerClaim ;
    skos:definition "Afirmação que identifica, com direção e magnitude precisas, qual truthmaker deveria mudar para alterar a Preferred Bearer."@pt .

side:CurtailmentWindow a owl:Class ;
    rdfs:label "CurtailmentWindow"@en ;
    rdfs:subClassOf cover:RiskEnabler,
        cover:ValueEnabler ;
    skos:definition "Janela temporal de corte de geração por restrição operativa. Simultaneamente Value Enabler (para H₂V e BESS, cujas disposições se manifestam nesse contexto gerando Gain Events) e Risk Enabler (para NI, pois a OpportunityCostVulnerability se manifesta produzindo Loss Events de receita não capturada). O papel é atribuído pela estratégia, não pela janela: a CurtailmentWindow é ontologicamente neutra."@pt .

side:DecisionContext a owl:Class ;
    skos:definition "Contexto decisório (estado × período) em relação ao qual as likelihoods e impactos são avaliados."@pt .

side:ElectrolyzerInvestmentCost a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsNegatively ;
            owl:someValuesFrom side:LowCostIntention ],
        cover:LossEvent .

side:EnergyArbitrageCapability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:manifestsAs ;
            owl:someValuesFrom side:ArbitrageGain ],
        cover:Capability .

side:FeasibilityStudy a owl:Class ;
    rdfs:label "FeasibilityStudy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cover:Truthmaker ;
            owl:onProperty side:qualifies ],
        ufo:InformationalArtifact ;
    skos:definition "Artefato informacional que identifica e qualifica os truthmakers técnicos, econômicos e espaciais do contexto decisório, alimentando o grafo de conhecimento."@pt .

side:FinancialFlexibilityCapability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:manifestsAs ;
            owl:someValuesFrom side:CapexPreservationGain ],
        cover:Capability .

side:FinancialFlexibilityIntention a owl:Class ;
    rdfs:subClassOf cover:Intention .

side:H2ProductionCapability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:manifestsAs ;
            owl:someValuesFrom side:H2ProductionGain ],
        cover:Capability .

side:HighCyclingDegradationVulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:produces ;
            owl:someValuesFrom side:BatteryDegradationLoss ],
        cover:Vulnerability ;
    skos:definition "Degradação acelerada das células no regime de alta ciclagem, elevando o LCOS acima do benefício de arbitragem."@pt .

side:HighProfitIntention a owl:Class ;
    rdfs:subClassOf cover:Intention .

side:IntermittentCurtailmentVulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty side:threatens ;
            owl:someValuesFrom side:H2ProductionGain ],
        cover:Vulnerability ;
    skos:definition "Dependência do FC para a viabilidade econômica do H₂V: abaixo do limiar em que LCOH atinge a paridade com o H₂ cinza, o H2ProductionGain converte-se em Loss."@pt .

side:LogisticsLoss a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsNegatively ;
            owl:someValuesFrom side:LowCostIntention ],
        cover:LossEvent .

side:LowPLDArbitrageVulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty side:threatens ;
            owl:someValuesFrom side:ArbitrageGain ],
        cover:Vulnerability ;
    skos:definition "Insuficiência do PLD de despacho para cobrir o LCOS. Desativada quando PLD_despacho ≥ LCOS."@pt .

side:OpportunityCostVulnerability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:produces ;
            owl:someValuesFrom side:RevenueOpportunityLoss ],
        cover:Vulnerability ;
    skos:definition "Disposição que inere na CurtailmentWindow e se manifesta a cada janela não aproveitada, produzindo RevenueOpportunityLoss de magnitude crescente."@pt .

side:RegulatoryRiskAvoidanceCapability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:manifestsAs ;
            owl:someValuesFrom side:RegulatoryRiskAvoidanceGain ],
        cover:Capability .

side:RegulatoryRiskAvoidanceGain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsPositively ;
            owl:someValuesFrom side:ComplianceCertaintyIntention ],
        cover:GainEvent .

side:RevenueOpportunityLoss a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsNegatively ;
            owl:someValuesFrom side:HighRevenueIntention ],
        cover:LossEvent .

side:StrategicFlexibilityIntention a owl:Class ;
    rdfs:subClassOf cover:Intention .

side:TechLockInAvoidanceCapability a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:manifestsAs ;
            owl:someValuesFrom side:TechLockInAvoidanceGain ],
        cover:Capability .

side:TechLockInAvoidanceGain a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cover:impactsPositively ;
            owl:someValuesFrom side:StrategicFlexibilityIntention ],
        cover:GainEvent .

side:ge_arbitrage a cover:GainEvent,
        side:ArbitrageGain,
        owl:NamedIndividual ;
    rdfs:label "Receita de arbitragem de energia armazenada"@pt ;
    cover:hasImpact "431570160.0"^^xsd:float ;
    cover:hasLikelihood "1.0"^^xsd:float ;
    cover:impactsPositively side:int_high_profit ;
    side:groundedInTruthmaker side:tm_eta_rt_090,
        side:tm_horas_ativas,
        side:tm_pld_arbitragem_92 ;
    side:occursIn side:rn_curtailment_window .

side:ge_h2_production a cover:GainEvent,
        side:H2ProductionGain,
        owl:NamedIndividual ;
    rdfs:label "Receita bruta de venda de H2 à paridade com o H2 cinza"@pt ;
    cover:hasImpact "248200000.0"^^xsd:float ;
    cover:hasLikelihood "1.0"^^xsd:float ;
    cover:impactsPositively side:int_high_revenue ;
    side:groundedInTruthmaker side:tm_fc_595,
        side:tm_horas_ativas,
        side:tm_kappa_525,
        side:tm_paridade_h2_250,
        side:tm_potencia_1000 ;
    side:occursIn side:rn_curtailment_window .

side:int_compliance a side:ComplianceCertaintyIntention,
        owl:NamedIndividual .

side:int_fin_flex a side:FinancialFlexibilityIntention,
        owl:NamedIndividual .

side:int_high_profit a side:HighProfitIntention,
        owl:NamedIndividual .

side:int_strat_flex a side:StrategicFlexibilityIntention,
        owl:NamedIndividual .

side:threatens a owl:ObjectProperty ;
    rdfs:domain cover:Vulnerability ;
    rdfs:range cover:GainEvent ;
    skos:definition "Disposição cuja manifestação converte um Gain Event em Loss Event sem produzir, ela própria, um Loss Event distinto. Extensão desta implementação em relação à COVeR: distingue vulnerabilidades que geram perda (cover:produces) daquelas que atuam sobre a magnitude ou o sinal de um ganho existente."@pt .

