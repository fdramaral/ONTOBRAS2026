ufo:Agent a owl:Class ;
    rdfs:subClassOf ufo:Object .

cover:impactsNegatively a owl:ObjectProperty ;
    rdfs:domain cover:LossEvent ;
    rdfs:range cover:Intention .

cover:produces a owl:ObjectProperty ;
    rdfs:domain cover:Vulnerability ;
    rdfs:range cover:LossEvent ;
    rdfs:subPropertyOf cover:manifestsAs .

side:EnergyInvestmentDecision a owl:Class ;
    rdfs:label "EnergyInvestmentDecision"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass side:EnergyInvestor ;
            owl:onProperty cover:mediates ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass side:EnergyStrategy ;
            owl:onProperty cover:mediates ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass cover:NetUseValue ;
            owl:onProperty side:hasVUAV ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass cover:TruthmakerSet ;
            owl:onProperty cover:isGroundedIn ],
        cover:RiskAssessment,
        cover:ValueAscription ;
    skos:definition "Relator UFO — especialização simultânea de Risk Assessment e Value Ascription — que conecta um EnergyInvestor a uma instância de EnergyStrategy, fundamentado em um conjunto de truthmakers que tornam verdadeira a proposição de viabilidade associada."@pt .

side:LowCostIntention a owl:Class ;
    rdfs:subClassOf cover:Intention .

