    side:hasSymbol "h" ;
    side:isDerived true .

cover:TriggerEvent a owl:Class ;
    rdfs:subClassOf ufo:Event .

ufo:Event a owl:Class ;
    rdfs:subClassOf ufo:Perdurant .

cover:Truthmaker a owl:Class ;
    skos:definition "Entidade do mundo real cuja existência torna verdadeira uma proposição [Mulligan et al., 1984; Guarino et al., 2019]."@pt .

side:EconomicTruthmaker a owl:Class ;
    rdfs:subClassOf cover:Truthmaker ;
    skos:definition "Truthmaker econômico: CAPEX, OPEX, LCOH, LCOS, PLD, paridade H₂ cinza."@pt .

cover:LossEvent a owl:Class ;
    rdfs:subClassOf cover:ImpactEvent .

cover:Capability a owl:Class ;
    rdfs:subClassOf ufo:Disposition .

cover:Intention a owl:Class ;
    rdfs:subClassOf ufo:Intention .

side:TechnicalTruthmaker a owl:Class ;
    rdfs:subClassOf cover:Truthmaker ;
    skos:definition "Truthmaker técnico: FC, κ, η_RT, horas ativas, ciclos/ano."@pt .

cover:GainEvent a owl:Class ;
    rdfs:subClassOf cover:ImpactEvent .

side:rn_curtailment_window a side:CurtailmentWindow,
        owl:NamedIndividual ;
    rdfs:label "Janela de constrained-off RN 2024–2026"@pt ;
    side:groundedInTruthmaker side:tm_fc_595,
        side:tm_horas_ativas ;
    side:hasContext side:RioGrandeDoNorte_2025 .

cover:Vulnerability a owl:Class ;
    rdfs:subClassOf ufo:Disposition ;
    skos:definition "Disposição que inere em um Object at Risk e cuja manifestação produz Loss Events que impactam negativamente as Intentions do Risk Subject."@pt .

[] a owl:AllDisjointClasses ;
    owl:members ( cover:PreferredBearer cover:DeprecatedBearer ) .

[] a owl:AllDisjointClasses ;
    owl:members ( side:NoInvestmentStrategy side:H2VStrategy side:BESSStrategy ) .

[] a owl:AllDisjointClasses ;
    owl:members ( side:TechnicalTruthmaker side:EconomicTruthmaker side:SpatialTruthmaker ) .

