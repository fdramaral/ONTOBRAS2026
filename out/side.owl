  <rdf:Description rdf:about="http://purl.org/side/energy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:title xml:lang="pt">SIDE: extensão da COVeR para decisão de investimento em aproveitamento de constrained-off renovável</dct:title>
    <dct:description xml:lang="pt">Especialização da Common Ontology of Value and Risk (COVeR) ao domínio de planejamento energético, com truthmakers mensuráveis, refinamento ontológico da estratégia de não investimento (NI) e a função VUAV como operacionalização da Net Use Value Ascription.</dct:description>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:creator>Francisco D. R. do Amaral</dct:creator>
    <dct:creator>Mateus Peixoto</dct:creator>
    <dct:creator>Fernanda Baião</dct:creator>
    <dct:creator>Paula Maçaira</dct:creator>
    <dct:rightsHolder>Amaral, Peixoto, Baião e Maçaira (2026)</dct:rightsHolder>
    <rdfs:seeAlso rdf:resource="http://purl.org/side/cover"/>
  </rdf:Description>
