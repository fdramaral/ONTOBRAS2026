  <rdf:Description rdf:about="http://purl.org/side/energy#threatens">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.org/side/cover#Vulnerability"/>
    <rdfs:range rdf:resource="http://purl.org/side/cover#GainEvent"/>
    <skos:definition xml:lang="pt">Disposição cuja manifestação converte um Gain Event em Loss Event sem produzir, ela própria, um Loss Event distinto. Extensão desta implementação em relação à COVeR: distingue vulnerabilidades que geram perda (cover:produces) daquelas que atuam sobre a magnitude ou o sinal de um ganho existente.</skos:definition>
  </rdf:Description>
