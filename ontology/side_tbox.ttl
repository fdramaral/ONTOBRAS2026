@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

@prefix ufo:   <http://purl.org/side/ufo#> .
@prefix cover: <http://purl.org/side/cover#> .
@prefix side:  <http://purl.org/side/energy#> .

################################################################################
# SIDE — Sustainable Investment Decision Extension
# Extensão da COVeR (Common Ontology of Value and Risk) ao domínio de decisão de
# investimento em aproveitamento de constrained-off renovável.
#
# Correspondência com o artigo ONTOBRAS/WTDO 2026 (Amaral, Peixoto, Baião e
# Maçaira): Seção 3.1 (quatro estruturas especializadas), Seção 3.2 (refinamento
# de NI), Seção 3.3 (VUAV), Figura 4 (fragmento OWL 2 em Manchester Syntax).
#
# NOTA SOBRE OS NAMESPACES ufo: E cover:
# As classes declaradas sob ufo: e cover: são STUBS de alinhamento. A COVeR
# [Sales et al., 2018] e a UFO [Guizzardi et al., 2022] não possuem, até a data
# desta implementação, uma serialização OWL canônica publicada com IRIs estáveis.
# Os stubs abaixo reproduzem apenas a taxonomia mínima necessária para ancorar a
# extensão SIDE. Caso uma serialização oficial seja adotada, basta substituir os
# prefixos e declarar owl:equivalentClass entre os stubs e as classes oficiais.
################################################################################

<http://purl.org/side/energy>
    a owl:Ontology ;
    dct:title "SIDE: extensão da COVeR para decisão de investimento em aproveitamento de constrained-off renovável"@pt ;
    dct:description "Especialização da Common Ontology of Value and Risk (COVeR) ao domínio de planejamento energético, com truthmakers mensuráveis, refinamento ontológico da estratégia de não investimento (NI) e a função VUAV como operacionalização da Net Use Value Ascription."@pt ;
    owl:versionInfo "1.0.0" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:creator "Francisco D. R. do Amaral", "Mateus Peixoto", "Fernanda Baião", "Paula Maçaira" ;
    dct:rightsHolder "Amaral, Peixoto, Baião e Maçaira (2026)" ;
    rdfs:seeAlso <http://purl.org/side/cover> .
# Sem owl:imports: os stubs COVeR/UFO estão declarados neste mesmo arquivo. Ao
# adotar uma serialização oficial da COVeR, trocar rdfs:seeAlso por owl:imports.

################################################################################
# 1. STUBS UFO
################################################################################

ufo:Endurant     a owl:Class .
ufo:Perdurant    a owl:Class .
ufo:Object       a owl:Class ; rdfs:subClassOf ufo:Endurant .
ufo:Agent        a owl:Class ; rdfs:subClassOf ufo:Object .
ufo:Relator      a owl:Class ; rdfs:subClassOf ufo:Endurant .
ufo:Moment       a owl:Class ; rdfs:subClassOf ufo:Endurant .
ufo:Disposition  a owl:Class ; rdfs:subClassOf ufo:Moment ;
    skos:definition "Modo inerente a um objeto que pode habilitar eventos e, portanto, justificar tendências comportamentais."@pt .
ufo:Quality      a owl:Class ; rdfs:subClassOf ufo:Moment .
ufo:Intention    a owl:Class ; rdfs:subClassOf ufo:Moment .
ufo:Event        a owl:Class ; rdfs:subClassOf ufo:Perdurant .
ufo:Situation    a owl:Class .
ufo:InformationalArtifact a owl:Class ; rdfs:subClassOf ufo:Object .

################################################################################
# 2. STUBS COVeR  [Sales et al., 2018]
################################################################################

cover:ValueAscription a owl:Class ; rdfs:subClassOf ufo:Relator ;
    skos:definition "Relator que conecta um agente avaliador (Value Subject) ao alvo do julgamento de valor de uso."@pt .

cover:RiskAssessment a owl:Class ; rdfs:subClassOf cover:ValueAscription ;
    skos:definition "Caso particular de atribuição de valor: avaliação de risco como valor de uso negativo."@pt .

cover:ValueSubject a owl:Class ; rdfs:subClassOf ufo:Agent .
cover:RiskSubject  a owl:Class ; rdfs:subClassOf ufo:Agent .
cover:ValueObject  a owl:Class ; rdfs:subClassOf ufo:Object .
cover:ValueEnabler a owl:Class ; rdfs:subClassOf ufo:Object .
cover:RiskEnabler  a owl:Class ; rdfs:subClassOf ufo:Object .

cover:ValueExperience a owl:Class ; rdfs:subClassOf ufo:Event .
cover:RiskExperience  a owl:Class ; rdfs:subClassOf ufo:Event .

cover:TriggerEvent a owl:Class ; rdfs:subClassOf ufo:Event .
cover:ThreatEvent  a owl:Class ; rdfs:subClassOf ufo:Event .
cover:ImpactEvent  a owl:Class ; rdfs:subClassOf ufo:Event .
cover:GainEvent    a owl:Class ; rdfs:subClassOf cover:ImpactEvent .
cover:LossEvent    a owl:Class ; rdfs:subClassOf cover:ImpactEvent .

cover:Capability       a owl:Class ; rdfs:subClassOf ufo:Disposition .
cover:ThreatCapability a owl:Class ; rdfs:subClassOf ufo:Disposition .
cover:Vulnerability    a owl:Class ; rdfs:subClassOf ufo:Disposition ;
    skos:definition "Disposição que inere em um Object at Risk e cuja manifestação produz Loss Events que impactam negativamente as Intentions do Risk Subject."@pt .

cover:Intention           a owl:Class ; rdfs:subClassOf ufo:Intention .
cover:ThreateningSituation a owl:Class ; rdfs:subClassOf ufo:Situation .

cover:UseValue     a owl:Class ; rdfs:subClassOf ufo:Quality .
cover:NetUseValue  a owl:Class ; rdfs:subClassOf cover:UseValue ;
    skos:definition "Atribuição combinada de valor de uso e risco sobre o alvo da avaliação como um todo."@pt .

cover:Truthmaker a owl:Class ;
    skos:definition "Entidade do mundo real cuja existência torna verdadeira uma proposição [Mulligan et al., 1984; Guarino et al., 2019]."@pt .
cover:TruthmakerSet a owl:Class .

cover:ProspectBearer  a owl:Class .
cover:PreferredBearer a owl:Class ; rdfs:subClassOf cover:ProspectBearer .
cover:DeprecatedBearer a owl:Class ; rdfs:subClassOf cover:ProspectBearer .
[] a owl:AllDisjointClasses ;
   owl:members ( cover:PreferredBearer cover:DeprecatedBearer ) .

################################################################################
# 3. PROPRIEDADES DE OBJETO
################################################################################

cover:mediates a owl:ObjectProperty ;
    rdfs:domain ufo:Relator ;
    rdfs:comment "Conecta um relator às entidades que ele existencialmente depende."@pt .

cover:isGroundedIn a owl:ObjectProperty ;
    rdfs:comment "Conecta uma decisão ao conjunto de truthmakers que a fundamentam."@pt .

cover:hasMember a owl:ObjectProperty ;
    rdfs:domain cover:TruthmakerSet ; rdfs:range cover:Truthmaker .

cover:hasCapability a owl:ObjectProperty ;
    rdfs:range cover:Capability .

cover:hasVulnerability a owl:ObjectProperty ;
    rdfs:range cover:Vulnerability .

cover:manifestsAs a owl:ObjectProperty ;
    rdfs:domain ufo:Disposition ; rdfs:range ufo:Event ;
    rdfs:comment "Manifestação de uma disposição como evento."@pt .

cover:produces a owl:ObjectProperty ;
    rdfs:domain cover:Vulnerability ; rdfs:range cover:LossEvent ;
    rdfs:subPropertyOf cover:manifestsAs .

cover:impactsPositively a owl:ObjectProperty ;
    rdfs:domain cover:GainEvent ; rdfs:range cover:Intention .

cover:impactsNegatively a owl:ObjectProperty ;
    rdfs:domain cover:LossEvent ; rdfs:range cover:Intention .

cover:hasIntention a owl:ObjectProperty ;
    rdfs:domain ufo:Agent ; rdfs:range cover:Intention .

cover:triggeredBy a owl:ObjectProperty ;
    rdfs:range cover:TriggerEvent .

cover:inheresIn a owl:ObjectProperty ;
    rdfs:domain ufo:Moment ; rdfs:range ufo:Endurant .

side:threatens a owl:ObjectProperty ;
    rdfs:domain cover:Vulnerability ; rdfs:range cover:GainEvent ;
    skos:definition "Disposição cuja manifestação converte um Gain Event em Loss Event sem produzir, ela própria, um Loss Event distinto. Extensão desta implementação em relação à COVeR: distingue vulnerabilidades que geram perda (cover:produces) daquelas que atuam sobre a magnitude ou o sinal de um ganho existente."@pt .

cover:isActivatedBy a owl:ObjectProperty ;
    rdfs:domain cover:Vulnerability ; rdfs:range cover:ThreateningSituation .

side:hasVUAV a owl:ObjectProperty ;
    rdfs:domain side:EnergyInvestmentDecision ; rdfs:range cover:NetUseValue ;
    rdfs:label "hasVUAV"@en ;
    skos:definition "Valor de Uso Líquido Ajustado por Vulnerabilidades — operacionalização quantitativa da Net Use Value Ascription da COVeR."@pt .

side:hasContext a owl:ObjectProperty ;
    rdfs:range side:DecisionContext .

side:occursIn a owl:ObjectProperty ;
    rdfs:domain ufo:Event ; rdfs:range side:CurtailmentWindow .

side:groundedInTruthmaker a owl:ObjectProperty ;
    rdfs:domain cover:ImpactEvent ; rdfs:range cover:Truthmaker ;
    rdfs:comment "Rastreabilidade de um Gain/Loss Event às entidades que o tornam verdadeiro."@pt .

side:qualifies a owl:ObjectProperty ;
    rdfs:domain side:FeasibilityStudy ; rdfs:range cover:Truthmaker .

side:hasBearerStatus a owl:ObjectProperty ;
    rdfs:domain side:EnergyStrategy ; rdfs:range cover:ProspectBearer .

side:revertsPreferenceOf a owl:ObjectProperty ;
    rdfs:domain side:CounterfactualClaim ; rdfs:range side:EnergyStrategy .

side:altersTruthmaker a owl:ObjectProperty ;
    rdfs:domain side:CounterfactualClaim ; rdfs:range cover:Truthmaker .

################################################################################
# 4. PROPRIEDADES DE DADOS
################################################################################

cover:hasValue     a owl:DatatypeProperty ; rdfs:range xsd:float .
cover:hasUnit      a owl:DatatypeProperty ; rdfs:range xsd:string .
cover:hasLikelihood a owl:DatatypeProperty ; rdfs:range xsd:float ;
    skos:definition "L(·): probabilidade ou grau de crença na ocorrência do evento, dado o contexto e a estratégia."@pt .
cover:hasImpact    a owl:DatatypeProperty ; rdfs:range xsd:float ;
    skos:definition "I(·): impacto positivo do Gain Event sobre as Intentions do agente, em USD/ano."@pt .
cover:hasSeverity  a owl:DatatypeProperty ; rdfs:range xsd:float ;
    skos:definition "S(·): severidade negativa do Loss Event sobre as Intentions do agente, em USD/ano."@pt .

side:hasSymbol            a owl:DatatypeProperty ; rdfs:range xsd:string .
side:hasLikelihoodGrowthRate a owl:DatatypeProperty ; rdfs:range xsd:float ;
    skos:definition "Taxa anual de crescimento de L(LE|s,ctx), usada para representar vulnerabilidades de magnitude crescente (e.g. OpportunityCostVulnerability de NI)."@pt .
side:hasThreshold         a owl:DatatypeProperty ; rdfs:range xsd:float .
side:hasThresholdDirection a owl:DatatypeProperty ; rdfs:range xsd:string ;
    skos:definition "'geq' ou 'leq': direção em que a alteração do truthmaker inverte a preferência."@pt .
side:isActive             a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:domain cover:Vulnerability ;
    skos:definition "Verdadeiro quando a Vulnerability está manifesta no contexto avaliado. Uma vulnerability inativa permanece inerente à estratégia, mas não produz Loss Events — é essa distinção que torna a reversão de preferência representável."@pt .

side:isDerived            a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    skos:definition "Verdadeiro quando o valor do truthmaker é derivado de outros truthmakers e não medido diretamente."@pt .
side:derivationFormula    a owl:DatatypeProperty ; rdfs:range xsd:string .
side:hasSourceCitation    a owl:DatatypeProperty ; rdfs:range xsd:string .

################################################################################
# 5. AS QUATRO ESTRUTURAS ESPECIALIZADAS DA COVeR  (Seção 3.1 do artigo)
################################################################################

# ---- (1) EnergyInvestmentDecision  ------------------------------------------
# Reproduz literalmente o fragmento da Figura 4 (Manchester Syntax):
#   Class: EnergyInvestmentDecision
#     SubClassOf: RiskAssessment, ValueAscription,
#       mediates exactly 1 EnergyInvestor, mediates exactly 1 EnergyStrategy,
#       hasVUAV exactly 1 NetUseValue, isGroundedIn min 1 TruthmakerSet

side:EnergyInvestmentDecision a owl:Class ;
    rdfs:label "EnergyInvestmentDecision"@en ;
    rdfs:subClassOf cover:RiskAssessment , cover:ValueAscription ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:mediates ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass side:EnergyInvestor ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:mediates ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass side:EnergyStrategy ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty side:hasVUAV ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass cover:NetUseValue ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:isGroundedIn ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass cover:TruthmakerSet ] ;
    skos:definition "Relator UFO — especialização simultânea de Risk Assessment e Value Ascription — que conecta um EnergyInvestor a uma instância de EnergyStrategy, fundamentado em um conjunto de truthmakers que tornam verdadeira a proposição de viabilidade associada."@pt .

side:EnergyInvestor a owl:Class ;
    rdfs:subClassOf cover:ValueSubject , cover:RiskSubject ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasIntention ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass cover:Intention ] ;
    skos:definition "Investidor com capital disponível para imobilização em infraestrutura de aproveitamento do constrained-off."@pt .

side:IndustrialInvestor a owl:Class ; rdfs:subClassOf side:EnergyInvestor .
side:ESGInvestor        a owl:Class ; rdfs:subClassOf side:EnergyInvestor .

# ---- (2) EnergyStrategy  ----------------------------------------------------

side:EnergyStrategy a owl:Class ;
    rdfs:subClassOf cover:ValueObject ;
    skos:definition "Especialização de Value Object, portando disposições cujas manifestações constituem Value Experiences ou Risk Experiences."@pt .

# Refinamento ontológico central (Seção 3.2): NI NÃO é uma classe vazia.
side:NoInvestmentStrategy a owl:Class ;
    rdfs:label "NoInvestmentStrategy"@en ;
    rdfs:subClassOf side:EnergyStrategy ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasCapability ;
        owl:someValuesFrom side:FinancialFlexibilityCapability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasCapability ;
        owl:someValuesFrom side:TechLockInAvoidanceCapability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasCapability ;
        owl:someValuesFrom side:RegulatoryRiskAvoidanceCapability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasVulnerability ;
        owl:someValuesFrom side:OpportunityCostVulnerability ] ;
    skos:definition "Estratégia de não imobilização de capital. Ao contrário do tratamento convencional que a reduz a um zero na função objetivo, porta Capabilities e Vulnerability próprias, declaradas como restrições existenciais."@pt .

side:H2VStrategy a owl:Class ;
    rdfs:label "H2VStrategy"@en ;
    rdfs:subClassOf side:EnergyStrategy ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasCapability ;
        owl:someValuesFrom side:H2ProductionCapability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasVulnerability ;
        owl:someValuesFrom side:IntermittentCurtailmentVulnerability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasVulnerability ;
        owl:someValuesFrom side:CapexIntensityVulnerability ] ;
    skos:definition "Instalação de eletrolisador alcalino (AWE) para conversão do constrained-off em hidrogênio verde."@pt .

side:BESSStrategy a owl:Class ;
    rdfs:label "BESSStrategy"@en ;
    rdfs:subClassOf side:EnergyStrategy ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasCapability ;
        owl:someValuesFrom side:EnergyArbitrageCapability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasVulnerability ;
        owl:someValuesFrom side:HighCyclingDegradationVulnerability ] ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty cover:hasVulnerability ;
        owl:someValuesFrom side:LowPLDArbitrageVulnerability ] ;
    skos:definition "Instalação de armazenamento por baterias para arbitragem entre janelas de constrained-off e períodos de escassez."@pt .

side:EnergyStrategy owl:equivalentClass [ a owl:Class ;
    owl:unionOf ( side:NoInvestmentStrategy side:H2VStrategy side:BESSStrategy ) ] .

[] a owl:AllDisjointClasses ;
   owl:members ( side:NoInvestmentStrategy side:H2VStrategy side:BESSStrategy ) .

# ---- (3) CurtailmentWindow  -------------------------------------------------

side:CurtailmentWindow a owl:Class ;
    rdfs:label "CurtailmentWindow"@en ;
    rdfs:subClassOf cover:ValueEnabler , cover:RiskEnabler ;
    skos:definition "Janela temporal de corte de geração por restrição operativa. Simultaneamente Value Enabler (para H₂V e BESS, cujas disposições se manifestam nesse contexto gerando Gain Events) e Risk Enabler (para NI, pois a OpportunityCostVulnerability se manifesta produzindo Loss Events de receita não capturada). O papel é atribuído pela estratégia, não pela janela: a CurtailmentWindow é ontologicamente neutra."@pt .

# ---- (4) FeasibilityStudy  --------------------------------------------------

side:FeasibilityStudy a owl:Class ;
    rdfs:label "FeasibilityStudy"@en ;
    rdfs:subClassOf ufo:InformationalArtifact ;
    rdfs:subClassOf [ a owl:Restriction ;
        owl:onProperty side:qualifies ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass cover:Truthmaker ] ;
    skos:definition "Artefato informacional que identifica e qualifica os truthmakers técnicos, econômicos e espaciais do contexto decisório, alimentando o grafo de conhecimento."@pt .

side:DecisionContext a owl:Class ;
    skos:definition "Contexto decisório (estado × período) em relação ao qual as likelihoods e impactos são avaliados."@pt .

################################################################################
# 6. TRUTHMAKERS
################################################################################

side:TechnicalTruthmaker a owl:Class ; rdfs:subClassOf cover:Truthmaker ;
    skos:definition "Truthmaker técnico: FC, κ, η_RT, horas ativas, ciclos/ano."@pt .
side:EconomicTruthmaker  a owl:Class ; rdfs:subClassOf cover:Truthmaker ;
    skos:definition "Truthmaker econômico: CAPEX, OPEX, LCOH, LCOS, PLD, paridade H₂ cinza."@pt .
side:SpatialTruthmaker   a owl:Class ; rdfs:subClassOf cover:Truthmaker ;
    skos:definition "Truthmaker espacial: distância ao porto de exportação, disponibilidade de infraestrutura."@pt .

[] a owl:AllDisjointClasses ;
   owl:members ( side:TechnicalTruthmaker side:EconomicTruthmaker side:SpatialTruthmaker ) .

################################################################################
# 7. CAPABILITIES
################################################################################

side:FinancialFlexibilityCapability a owl:Class ; rdfs:subClassOf cover:Capability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:manifestsAs ;
                      owl:someValuesFrom side:CapexPreservationGain ] .
side:TechLockInAvoidanceCapability a owl:Class ; rdfs:subClassOf cover:Capability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:manifestsAs ;
                      owl:someValuesFrom side:TechLockInAvoidanceGain ] .
side:RegulatoryRiskAvoidanceCapability a owl:Class ; rdfs:subClassOf cover:Capability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:manifestsAs ;
                      owl:someValuesFrom side:RegulatoryRiskAvoidanceGain ] .
side:H2ProductionCapability a owl:Class ; rdfs:subClassOf cover:Capability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:manifestsAs ;
                      owl:someValuesFrom side:H2ProductionGain ] .
side:EnergyArbitrageCapability a owl:Class ; rdfs:subClassOf cover:Capability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:manifestsAs ;
                      owl:someValuesFrom side:ArbitrageGain ] .

################################################################################
# 8. VULNERABILITIES
################################################################################

side:OpportunityCostVulnerability a owl:Class ; rdfs:subClassOf cover:Vulnerability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:produces ;
                      owl:someValuesFrom side:RevenueOpportunityLoss ] ;
    skos:definition "Disposição que inere na CurtailmentWindow e se manifesta a cada janela não aproveitada, produzindo RevenueOpportunityLoss de magnitude crescente."@pt .

side:IntermittentCurtailmentVulnerability a owl:Class ; rdfs:subClassOf cover:Vulnerability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty side:threatens ;
                      owl:someValuesFrom side:H2ProductionGain ] ;
    skos:definition "Dependência do FC para a viabilidade econômica do H₂V: abaixo do limiar em que LCOH atinge a paridade com o H₂ cinza, o H2ProductionGain converte-se em Loss."@pt .

side:CapexIntensityVulnerability a owl:Class ; rdfs:subClassOf cover:Vulnerability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:produces ;
                      owl:someValuesFrom side:ElectrolyzerInvestmentCost ] ;
    skos:definition "Imobilização de capital em ativo específico sem liquidação imediata; impacta negativamente a StrategicFlexibilityIntention."@pt .

side:HighCyclingDegradationVulnerability a owl:Class ; rdfs:subClassOf cover:Vulnerability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:produces ;
                      owl:someValuesFrom side:BatteryDegradationLoss ] ;
    skos:definition "Degradação acelerada das células no regime de alta ciclagem, elevando o LCOS acima do benefício de arbitragem."@pt .

side:LowPLDArbitrageVulnerability a owl:Class ; rdfs:subClassOf cover:Vulnerability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty side:threatens ;
                      owl:someValuesFrom side:ArbitrageGain ] ;
    skos:definition "Insuficiência do PLD de despacho para cobrir o LCOS. Desativada quando PLD_despacho ≥ LCOS."@pt .

side:LogisticsDistanceVulnerability a owl:Class ; rdfs:subClassOf cover:Vulnerability ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:produces ;
                      owl:someValuesFrom side:LogisticsLoss ] ;
    skos:definition "Distância ao porto de exportação e ausência de infraestrutura portuária de H₂, adicionando custo logístico ao LCOH."@pt .

################################################################################
# 9. GAIN EVENTS E LOSS EVENTS
################################################################################

side:CapexPreservationGain a owl:Class ; rdfs:subClassOf cover:GainEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsPositively ;
                      owl:someValuesFrom side:FinancialFlexibilityIntention ] .
side:TechLockInAvoidanceGain a owl:Class ; rdfs:subClassOf cover:GainEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsPositively ;
                      owl:someValuesFrom side:StrategicFlexibilityIntention ] .
side:RegulatoryRiskAvoidanceGain a owl:Class ; rdfs:subClassOf cover:GainEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsPositively ;
                      owl:someValuesFrom side:ComplianceCertaintyIntention ] .
side:H2ProductionGain a owl:Class ; rdfs:subClassOf cover:GainEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsPositively ;
                      owl:someValuesFrom side:HighRevenueIntention ] .
side:ArbitrageGain a owl:Class ; rdfs:subClassOf cover:GainEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsPositively ;
                      owl:someValuesFrom side:HighProfitIntention ] .

side:RevenueOpportunityLoss a owl:Class ; rdfs:subClassOf cover:LossEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsNegatively ;
                      owl:someValuesFrom side:HighRevenueIntention ] .
side:ElectrolyzerInvestmentCost a owl:Class ; rdfs:subClassOf cover:LossEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsNegatively ;
                      owl:someValuesFrom side:LowCostIntention ] .
side:BatteryDegradationLoss a owl:Class ; rdfs:subClassOf cover:LossEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsNegatively ;
                      owl:someValuesFrom side:LowCostIntention ] ;
    skos:altLabel "BatteryInvestmentCost"@en .
side:LogisticsLoss a owl:Class ; rdfs:subClassOf cover:LossEvent ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cover:impactsNegatively ;
                      owl:someValuesFrom side:LowCostIntention ] .

################################################################################
# 10. INTENTIONS
################################################################################

side:HighRevenueIntention         a owl:Class ; rdfs:subClassOf cover:Intention .
side:HighProfitIntention          a owl:Class ; rdfs:subClassOf cover:Intention .
side:LowCostIntention             a owl:Class ; rdfs:subClassOf cover:Intention .
side:FinancialFlexibilityIntention a owl:Class ; rdfs:subClassOf cover:Intention .
side:StrategicFlexibilityIntention a owl:Class ; rdfs:subClassOf cover:Intention .
side:ComplianceCertaintyIntention a owl:Class ; rdfs:subClassOf cover:Intention .
side:LowCarbonEmissionIntention   a owl:Class ; rdfs:subClassOf cover:Intention .

################################################################################
# 11. TRIGGER EVENTS E THREATENING SITUATIONS  (Tabela 3 do artigo)
################################################################################

side:CurtailmentWithNoInvestment          a owl:Class ; rdfs:subClassOf cover:TriggerEvent .
side:CurtailmentWithElectrolyzerInvestment a owl:Class ; rdfs:subClassOf cover:TriggerEvent .
side:CurtailmentWithBatteryInvestment      a owl:Class ; rdfs:subClassOf cover:TriggerEvent .

side:GenerationCapacityConstrainedByCurtailment a owl:Class ; rdfs:subClassOf cover:ThreateningSituation .
side:ElectrolyzerInvestmentNeed a owl:Class ; rdfs:subClassOf cover:ThreateningSituation .
side:BatteryInvestmentNeed      a owl:Class ; rdfs:subClassOf cover:ThreateningSituation .
side:H2PriceInstability         a owl:Class ; rdfs:subClassOf cover:ThreateningSituation ;
    skos:definition "Volatilidade do preço internacional do H₂ como ameaça distinta da IntermittentCurtailmentVulnerability."@pt .

################################################################################
# 12. EXPLICAÇÃO POR ONTOLOGICAL UNPACKING
################################################################################

side:TruthmakerClaim a owl:Class ;
    skos:definition "Afirmação verificável que identifica quais entidades do mundo fundamentam a preferência sobre uma estratégia."@pt .

side:CounterfactualClaim a owl:Class ;
    rdfs:subClassOf side:TruthmakerClaim ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty side:altersTruthmaker ;
                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                      owl:onClass cover:Truthmaker ] ;
    skos:definition "Afirmação que identifica, com direção e magnitude precisas, qual truthmaker deveria mudar para alterar a Preferred Bearer."@pt .

side:CompetencyQuestion a owl:Class .
